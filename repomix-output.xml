<file path="prisma/schema.prisma">
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes        Note[]
  sharedAccess SharedAccess[]

  @@index([email])
}

// Note model - represents a single note created by a user
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text          // Use Text type for large content
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key relationship to User
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relationship to SharedAccess (this note can be shared with multiple users)
  sharedWith SharedAccess[]

  // Index for faster queries by ownerId
  @@index([ownerId])
}

// SharedAccess model - represents permissions for a note
model SharedAccess {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  permission String  // "VIEW" or "EDIT"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key relationships
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite unique constraint: can't share same note twice with same user
  @@unique([noteId, userId])
  @@index([userId])
}
</file>

